# Copy to .env in EACH worktree. Allocate ports under docs/WORKFLOW.md first.
APP_ENV=development
COMPOSE_PROJECT_NAME=qa-todo-NNN-replace-me
API_PORT=8101
WEB_PORT=5201
DB_PORT=15433
POSTGRES_USER=qa
POSTGRES_DB=qa_dev
# Generate a hex password and replace all three matching values below.
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_URL=postgresql+psycopg://qa:replace-with-random-hex-password@127.0.0.1:15433/qa_dev
TEST_DATABASE_URL=postgresql+psycopg://qa:replace-with-random-hex-password@127.0.0.1:15433/qa_test
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
UPLOAD_DIR=.local/uploads

# Production requires HTTPS public origin and SESSION_SECRET >= 32 characters.
# PUBLIC_ORIGIN=https://example.invalid
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=30
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_ENTRIES=10000

# Server-only provider: mock/cloud/ollama. Defaults to mock.
MODEL_PROVIDER=mock
# Cloud: HTTPS base URL including version path; Ollama: local root URL (e.g. http://127.0.0.1:11434).
MODEL_BASE_URL=https://example.invalid/v1
MODEL_ID=example-model
MODEL_ALLOWED_IDS=["example-model"]
# Cloud requires a key. Ollama uses no Authorization header.
MODEL_API_KEY=
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=512

# Explicit thinking control: cloud DeepSeek thinking.type=disabled; Ollama think:false.
MODEL_DISABLE_THINKING=false
# Ollama native context size, validated between 512 and 131072.
OLLAMA_NUM_CTX=4096

# Parser worker: absolute path to the pinned BGE tokenizer.json downloaded below.
# EMBEDDING_TOKENIZER_PATH=/absolute/path/to/bge-small-zh-v1.5/tokenizer.json
INGESTION_PARSE_TIMEOUT=60
# Offline CPU BGE embedding: local directory containing the pinned model snapshot.
# EMBEDDING_MODEL_PATH=/absolute/path/to/bge-small-zh-v1.5
# Initial cosine threshold; calibrate against representative data before deployment.
RETRIEVAL_THRESHOLD=0.65
# Evaluation defaults remain vector; hybrid and local reranking require explicit opt-in.
RETRIEVAL_MODE=vector
RETRIEVAL_RERANK_ENABLED=false
# Reranker uses the pinned offline CPU snapshot documented in experiments/evaluation.
RERANKER_MODEL_PATH=
RERANK_TIMEOUT_SECONDS=2

# Accepted RAG requests, including failures/cancellation; not vendor calls or monetary billing.
# Daily window uses Asia/Shanghai; one active generation per conversation, one API process.
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=60
CHAT_GLOBAL_CONCURRENCY=2
# Local container runtime reaches the host Ollama; keep the service local-only.
# LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434
